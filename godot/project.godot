; Engine configuration file.
; Godot 4.7. Edit through the editor or by hand.

config_version=5

[application]

config/name="ATC Raycrash"
config/description="Private recreation of ATC Raycrash (CodiNET, 2005) using the original rules and art."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; The original ran at 800x600. Keep its 4:3 shape at a larger size.
window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

